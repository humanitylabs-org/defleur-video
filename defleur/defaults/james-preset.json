{
  "version": 1,
  "name": "james",
  "description": "James DeFleur's house Shorts style. Default for every DeFleur edit; owner/project presets override any key.",
  "caption": {
    "font_path": "",
    "font_match": "Montserrat:style=Black",
    "font_note": "James' masters use Arial Black; Montserrat Black (SIL OFL, Debian fonts-montserrat) is the redistributable stand-in. Put arialbd/ariblk in a project preset font_path when licensed.",
    "font_size_px": 72,
    "active_scale": 1.08,
    "min_scale": 0.8,
    "uppercase": true,
    "max_words": 4,
    "max_chars": 18,
    "break_on_punctuation": true,
    "text_color": "#FFFFFF",
    "active_color": "#0FF42A",
    "emphasis_color": "#FAE626",
    "outline_color": "#000000",
    "outline_width_px": 6,
    "shadow_px": 4,
    "safe_rect": [
      120,
      1220,
      960,
      1460
    ]
  },
  "video": {
    "canvas": [
      1080,
      1920
    ],
    "essential_text_rect": [
      120,
      220,
      960,
      1180
    ],
    "live_crop_policy": "fixed-per-setup",
    "allow_fullscreen_insert_ranges": true
  },
  "editorial": {
    "auto_propose_fillers": true,
    "auto_propose_repeats_and_restarts": true,
    "shorten_long_pauses_to_s": 0.15,
    "shorten_noisy_pauses": true,
    "trim_leading_and_trailing_dead_air": true,
    "restore_clause_when_cut_is_fragile": true,
    "visual_media_families": [
      "documentary",
      "diagram",
      "photographic-metaphor",
      "typographic-explanation",
      "illustration"
    ]
  }
}
